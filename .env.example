# TOT configuration — copy to .env and fill in what you need. Everything is optional.
# Real environment variables take precedence over this file.

# boat.dev API key: gives every agent its own cloud VM with a desktop.
# Create one at https://boat.dev/dashboard?tab=api-keys (or paste it in Settings → Computer).
BOAT_API_KEY=

# Only for Claude "API key" mode (Settings → Models → Claude). Your Claude subscription needs no key.
ANTHROPIC_API_KEY=

# --- Other devices (phone, tablet, other computers) ------------------------------
# A sign-in token is required before TOT can be reached from anything but this machine.
# Browsers sign in once at /login (30-day session); scripts send `Authorization: Bearer <token>`.
# Dashes and capitals in the token don't matter. Generate one with e.g. `openssl rand -hex 16`.
TOT_ACCESS_TOKEN=

# Serve your local network (Wi-Fi): with `npm run dev` the web app listens on your LAN
# (the API stays private behind it); with `npm start` the server itself does. IPv4 only.
# Needs TOT_ACCESS_TOKEN. For access from anywhere, use a tunnel instead (see README).
TOT_LAN=

# --- GitHub -------------------------------------------------------------------
# Connect GitHub in Settings → Connections (one click with the gh CLI login, or a token).
# Browser sign-in also needs a GitHub OAuth app's client id (device flow, no secret):
# TOT_GITHUB_CLIENT_ID=

# --- Apps (Executor) ---------------------------------------------------------------
# The port TOT runs Executor on. Google sign-in clients register
# http://localhost:<port>/api/oauth/callback, so keep it fixed once apps are connected.
# TOT_EXECUTOR_PORT=4791

# --- Server -------------------------------------------------------------------
# TOT_PORT=8787
# TOT_HOST=127.0.0.1
# TOT_DATA_DIR=/Users/you/.tot

# --- Advanced -----------------------------------------------------------------
# TOT_CLAUDE_CONFIG_DIR=      # if your Claude Code login lives in a custom config dir
# TOT_CODEX_PATH=             # use a specific codex binary instead of the bundled one
# BOAT_API_URL=https://boat.dev/api/v1
