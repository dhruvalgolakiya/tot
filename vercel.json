{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run site:build",
  "outputDirectory": "apps/site/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/site apps/web/public packages/shared package.json package-lock.json",
  "rewrites": [
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/(.*)", "destination": "/docs/index.html" }
  ]
}
