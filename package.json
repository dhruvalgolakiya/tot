{
  "name": "tot-monorepo",
  "private": true,
  "type": "module",
  "description": "TOT — an agent that runs on your own ChatGPT and Claude subscriptions, with a cloud computer per agent, long-term memory, and plugins.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/web",
    "apps/server",
    "apps/desktop",
    "apps/site",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false apps/server/index.ts",
    "dev:web": "npm run dev -w @tot/web",
    "build": "npm run build -w @tot/web",
    "site": "npm run dev -w @tot/site",
    "site:build": "npm run build -w @tot/site",
    "start": "NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx apps/server/index.ts",
    "app:dev": "npm run app:dev -w tot",
    "app:release": "apps/desktop/release.sh",
    "app:publish": "apps/desktop/publish.sh",
    "app:build": "npm run app:build -w tot",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts --noEmit",
    "test": "npm test -w @tot/server && npm test -w tot",
    "test:live": "npm run test:live -w @tot/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
